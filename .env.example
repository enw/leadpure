# Public URL for docs/curl examples (optional; Vercel sets VERCEL_URL automatically)
# NEXT_PUBLIC_APP_URL=https://leadpure.e10d.dev

# Database connection string (Neon PostgreSQL or any Postgres)
# Get a free DB at https://neon.tech
DATABASE_URL=postgres://user:password@host:5432/leadpure

# Self-host mode: skips rate limits, billing, provides unlimited key
# Set to "true" for docker-compose, "false" for hosted service
SELF_HOST=false

# Contact email in scraper User-Agent (SEC, websites, RDAP). Required for polite crawling.
LEADPURE_CONTACT_EMAIL=you@example.com

# GitHub API token — strongly recommended in production (5000 req/hr vs 60)
# GITHUB_TOKEN=
